#!/usr/bin/env bash

# If this scripts exits with a non-zero status, the git commit will be aborted.
echo "Executing pre-commit hook: apply prettier code formatter"

# exit immediately if a command exits with a non-zero status
set -e

# Info/debug log into console - what files are staged
git status

# get the names of the staged files, excluding deleted files
FILES=$(git diff --cached --name-only --diff-filter=d)
[ -z "$FILES" ] && exit 0

# add SPDX-Header to all files
mvn license:update-file-header
mvn license:update-file-header -f "./integrationstest-java/pom.xml"

# Filter only files supported by prettier-maven-plugin configuration (java, yaml/yml)
FILES_FILTERED=$(echo "$FILES" | tr ' ' '\n' | grep -E '\.(java|ya?ml)$' || true)

# If nothing to format after filtering, skip Prettier and continue
if [ -z "$FILES_FILTERED" ]; then
  echo "No Java/YAML files staged for Prettier. Skipping formatting."
  # re-stage possibly updated headers
  echo "$FILES" | xargs git add
  exit 0
fi

# format only filtered files - convert newline-separated list to comma-separated
FILES_COMMA=$(echo "$FILES_FILTERED" | tr '\n' ',' | sed 's/,$//')

mvn prettier:write "-Dprettier.inputGlobs=$FILES_COMMA"

# re-stage reformated files (and previously updated headers)
echo "$FILES" | xargs git add

exit 0
