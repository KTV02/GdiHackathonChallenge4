   <SimpleCodeList>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>001</SimpleValue>
         </Value>
         <Value ColumnRef="Typ">
            <SimpleValue>Hausanschrift</SimpleValue>
         </Value>
         <Value ColumnRef="type">
            <SimpleValue>Address</SimpleValue>
         </Value>
         <Value ColumnRef="Beschreibung">
            <SimpleValue>Dies ist die Adresse eines Ortes, an dem eine Person oder Organisation tatsächlich ansässig ist. Sie enthält in der Regel Straßenname, Hausnummer, Ort und Postleitzahl.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>005</SimpleValue>
         </Value>
         <Value ColumnRef="Typ">
            <SimpleValue>Lieferanschrift</SimpleValue>
         </Value>
         <Value ColumnRef="type">
            <SimpleValue>Delivery address</SimpleValue>
         </Value>
         <Value ColumnRef="Beschreibung">
            <SimpleValue>Dies ist die Adresse, an die alle Waren und Dienstleistungen geliefert werden sollen. Sie enthält in der Regel Straßenname, Hausnummer, Ort und Postleitzahl.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>006</SimpleValue>
         </Value>
         <Value ColumnRef="Typ">
            <SimpleValue>Postanschrift</SimpleValue>
         </Value>
         <Value ColumnRef="type">
            <SimpleValue>Postal address</SimpleValue>
         </Value>
         <Value ColumnRef="Beschreibung">
            <SimpleValue>Dies ist die Adresse, an die Postsendungen gesendet werden sollen. Es kann die Postfachanschrift angegeben werden. Diese enthält in der Regel die Nummer des Postfaches, Ort und Postleitzahl. Es kann auch die Großempfängeranschrift angegebegen werden. Diese enthält nur den Ort und die Postleitzahl.</SimpleValue>
         </Value>
      </Row>
