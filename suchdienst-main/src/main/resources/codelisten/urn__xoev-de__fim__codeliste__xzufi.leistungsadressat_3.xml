   <Annotation>
      <Description>
         <xoev-cl-4:shortName>Leistungsadressat</xoev-cl-4:shortName>
         <xoev-cl-4:codelistDescription>Über die Zuordnung des Leistungsadressaten wird festgelegt, wer die Verwaltungsleistung in Anspruch nehmen kann.</xoev-cl-4:codelistDescription>
         <xoev-cl-4:agencyShortName>GK_FIM</xoev-cl-4:agencyShortName>
         <xoev-cl-4:validFrom>2024-07-01</xoev-cl-4:validFrom>
         <xoev-cl-4:versionHandbook>1.2</xoev-cl-4:versionHandbook>
      </Description>
   </Annotation>
