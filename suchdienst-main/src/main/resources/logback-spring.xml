<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="false">
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <!-- Wir ueberschreiben die Patterndefinitionen aus der obigen defaults.xml,
      um den MDC aufzunehmen: -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr([%mdc]){magenta} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>
    <springProperty name="mvnVersion" source="info.app.version"/>
    <springProperty name="appName" source="info.app.name"/>
    <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
        <resetJUL>true</resetJUL>
    </contextListener>
    
    <springProfile name="!json_logging_off">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <provider class="net.logstash.logback.composite.loggingevent.ArgumentsJsonProvider"/>
                <customFields>{"appname":"${appName}","appversion":"${mvnVersion}"}</customFields>
                <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
                <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                    <!-- Alles, was nicht excluded wird, ist wichtig. Abgeschnitten wird am Ende, falls nötig.
                    <maxDepthPerThrowable>30</maxDepthPerThrowable>
                    -->
                    <!-- Docker trennt log-Zeilen nach 16kB (hartcodiert), ohne z.B. auf die json-Struktur Rücksicht -->
                    <!-- zu nehmen. Ein Wert von 8000 Character (multi-byte) hier lässt genug Platz für den Rest der Nachricht. -->
                    <maxLength>8000</maxLength>
                    <!-- Klassennamen selbst werden nie gekürzt. Ein größerer Wert hier würde aber dafür sorgen, -->
                    <!-- dass bei kurzen Klassennamen package-Namen nicht maximal gekürzt werden. -->
                    <shortenedClassNameLength>30</shortenedClassNameLength>
                    <!-- Ungewohnt, aber extrem hilfreich. -->
                    <rootCauseFirst>true</rootCauseFirst>
                    <!-- Stack Traces sollten selten sein und nicht verwaltet werden müssen. -->
                    <inlineHash>false</inlineHash>
                    <!-- Liste der excludes, basierend auf https://github.com/logfellow/logstash-logback-encoder/blob/main/stack-hash.md -->
                    <!-- generated class names -->
                    <exclude>\$\$FastClassByCGLIB\$\$</exclude>
                    <exclude>\$\$FastClassBySpringCGLIB\$\$</exclude>
                    <exclude>\$\$EnhancerBySpringCGLIB\$\$</exclude>
                    <exclude>sun\.reflect\.</exclude>
                    <!-- JDK internals -->
                    <exclude>com\.sun\.</exclude>
                    <exclude>sun\.net\.</exclude>
                    <exclude>jdk\.</exclude>
                    <!-- anything invoke, process, doFilter etc. -->
                    <exclude>
                        (org|com|java|javax)\..*\.(invoke|doInvoke|proceed|process|service|doService|intercept|filter|doFilter)
                    </exclude>
                    <exclude>org\.springframework\..*\.(execute|doExecute)</exclude>
                    <!-- Hibernate und Postgres -->
                    <exclude>org\.hibernate\..*\.(executeQueryStatement|list|doList|doQuery|execute)</exclude>
                    <exclude>org\.postgresql\..*\.execute</exclude>
                    <!-- Thread execution -->
                    <exclude>ThreadPoolExecutor\.runWorker</exclude>
                    <exclude>java\.lang\.Thread\.run$</exclude>
                    <!-- Tomcat internals -->
                    <exclude>org\.apache\.tomcat\..*\.(run|doRun)</exclude>
                    <exclude>org\.apache\.catalina\.core\.ApplicationFilterChain</exclude>
                    <!-- specials -->
                    <exclude>org\.springframework\.security\.web\.header\.HeaderWriterFilter</exclude>
                </throwableConverter>
            </encoder>
        </appender>
    </springProfile>

    <springProfile name="json_logging_off">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${CONSOLE_LOG_PATTERN}</pattern>
                <charset>utf8</charset>
            </encoder>
        </appender>
    </springProfile>
    
    <springProfile name="test">
        <appender name="FILE" class="ch.qos.logback.core.FileAppender">
            <file>./integrationstest-java/artifacts/fullServerLog.txt</file>
            <append>false</append>
            <encoder>
                <pattern>${CONSOLE_LOG_PATTERN}</pattern>
                <charset>utf8</charset>
            </encoder>
        </appender>
    </springProfile>
    
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <springProfile name="test">
        <root level="INFO">
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>
</configuration>
