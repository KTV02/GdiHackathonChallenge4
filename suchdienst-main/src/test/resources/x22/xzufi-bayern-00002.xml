    <xzufi:schreibe><xzufi:leistung><xzufi:id schemeAgencyID="L100012" schemeID="OID">8963791</xzufi:id><xzufi:idSekundaer schemeAgencyID="GK_LEIKA" schemeAgencyName="GK LeiKa" schemeID="LEIKA_LEISTUNG_SCHLUESSEL" schemeName="LeiKa Leistungsschlüssel" schemeVersionID="2">99132012027000</xzufi:idSekundaer><xzufi:struktur xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="xzufi:LeistungsstrukturObjektMitVerrichtung"><xzufi:leistungsobjektID schemeAgencyID="GK_LEIKA" schemeAgencyName="GK LeiKa" schemeID="LEIKA_LEISTUNG_SCHLUESSEL" schemeName="LeiKa Leistungsschlüssel" schemeVersionID="2">01132012000000</xzufi:leistungsobjektID><xzufi:verrichtung><xzufi:verrichtungLeiKa listURI="urn:de:fim:leika:verrichtung" listVersionID="20180103"><code>027</code><name>Förderung</name></xzufi:verrichtungLeiKa></xzufi:verrichtung></xzufi:struktur><xzufi:referenzLeiKa listURI="urn:de:fim:leika:leistung" listVersionID="20180705"><code>99132012027000</code></xzufi:referenzLeiKa><xzufi:modulText><xzufi:inhalt languageCode="de">Gemeinschaftsaufgabe "Verbesserung der regionalen Wirtschaftsstruktur" (GRW) in der Förderperiode 2014-2020</xzufi:inhalt><xzufi:inhalt languageCode="en">Joint task "Improvement of the regional economic structure" (GRW) in the 2014-2020 funding period</xzufi:inhalt><xzufi:leikaTextmodul listURI="urn:de:xzufi:codeliste:leistungstextmodulleika" listVersionID="20190605"><code>02</code></xzufi:leikaTextmodul></xzufi:modulText><xzufi:modulText><xzufi:positionDarstellung>11</xzufi:positionDarstellung><xzufi:inhalt languageCode="en">&lt;p&gt; The funding will be based on the coordination framework of the Joint Task "Improving the Regional Economic Structure" of 10 June 2015. It lays down the basic guidelines, the rules and rates of support and the assisted area. &lt;br&gt; &lt;br&gt; The all-German regional aid map entered into force on 1 July 2014 and has a valid period until 31 December 2020. &lt;br&gt; The coordination framework and the new all-German regional aid map can be found on the website of the Federal Ministry of Economic Affairs and Energy (BMWI), 4th and 5th paragraphs. &lt;/p&gt;</xzufi:inhalt><xzufi:inhalt languageCode="de">&lt;p&gt; Die Förderung erfolgt auf Basis des Koordinierungsrahmens der Gemeinschaftsaufgabe "Verbesserung der regionalen Wirtschaftsstruktur" vom 10. Juni 2015. Darin sind die grundsätzlichen Leitlinien, die Förderregeln und -sätze sowie das Fördergebiet festgelegt. &lt;br&gt; &lt;br&gt; Die gesamtdeutsche Fördergebietskarte ist am 1. Juli 2014 in Kraft getreten und hat eine Geltungsdauer bis zum bis 31. Dezember 2020. &lt;br&gt; Den Koordinierungsrahmen und die neue gesamtdeutsche Fördergebietskarte finden Sie auf den Internetseiten des Bundesministeriums für Wirtschaft und Energie (BMWI), 4. und 5. Absatz. &lt;/p&gt;</xzufi:inhalt><xzufi:leikaTextmodul listURI="urn:de:xzufi:codeliste:leistungstextmodulleika" listVersionID="20190605"><code>07</code></xzufi:leikaTextmodul><xzufi:weiterfuehrenderLink languageCode="de"><xzufi:uri>http://www.bmwi.de/DE/Themen/Wirtschaft/Regionalpolitik/gemeinschaftsaufgabe.html</xzufi:uri><xzufi:titel>Koordinierungsrahmen und Fördergebietskarten</xzufi:titel><xzufi:beschreibung>Keine weiteren Hinweise vorhanden</xzufi:beschreibung><xzufi:positionDarstellung>0</xzufi:positionDarstellung></xzufi:weiterfuehrenderLink><xzufi:weiterfuehrenderLink languageCode="en"><xzufi:uri>http://www.bmwi.de/DE/Themen/Wirtschaft/Regionalpolitik/gemeinschaftsaufgabe.html</xzufi:uri><xzufi:titel>Coordination framework and regional aid maps</xzufi:titel><xzufi:beschreibung>Keine weiteren Hinweise vorhanden</xzufi:beschreibung><xzufi:positionDarstellung>1</xzufi:positionDarstellung></xzufi:weiterfuehrenderLink></xzufi:modulText><xzufi:modulText><xzufi:positionDarstellung>7</xzufi:positionDarstellung><xzufi:inhalt languageCode="de">&lt;p&gt;Antragsteller&amp;#xa0;sollten sich frühzeitig mit den genannten Ansprechpartnern in Verbindung setzen, um abzuklären, welche Unterlagen im jeweiligen Einzelfall vorzulegen sind.&lt;/p&gt;</xzufi:inhalt><xzufi:inhalt languageCode="en">&lt;p&gt;Applicants should contact the above-mentioned contact persons at an early stage in order to clarify which documents are to be submitted in each individual case.&lt;/p&gt;</xzufi:inhalt><xzufi:leikaTextmodul listURI="urn:de:xzufi:codeliste:leistungstextmodulleika" listVersionID="20190605"><code>08</code></xzufi:leikaTextmodul></xzufi:modulText><xzufi:modulText><xzufi:positionDarstellung>4</xzufi:positionDarstellung><xzufi:inhalt languageCode="de">&lt;ul&gt; &lt;li&gt;An die Investitionsbank Schleswig-Holstein, sofern es sich um gewerbliche Investitionen, wirtschaftsnahe Infrastrukturinvestitionen oder um Kooperations-/Netzwerk-projekte handelt,&lt;/li&gt; &lt;li&gt;an die Wirtschaftsförderung und Technologietransfer Schleswig-Holstein GmbH (WTSH)&amp;#xa0;bei nicht-investiven betriebliche Innovationsmaßnahmen von KMU.&lt;/li&gt; &lt;/ul&gt;</xzufi:inhalt><xzufi:inhalt languageCode="en">&lt;ul&gt; &lt;li&gt;To the Schleswig-Holstein Investment Bank, in so far as it concerns commercial investments, business-related infrastructure investments or cooperation/network projects,&lt;/li&gt; &lt;li&gt;to the Economic Development and Technology Transfer Schleswig-Holstein GmbH (WTSH) for non-investment in the innovation of SMEs.&lt;/li&gt; &lt;/ul&gt;</xzufi:inhalt><xzufi:leikaTextmodul listURI="urn:de:xzufi:codeliste:leistungstextmodulleika" listVersionID="20190605"><code>23</code></xzufi:leikaTextmodul></xzufi:modulText><xzufi:modulText><xzufi:positionDarstellung>17</xzufi:positionDarstellung><xzufi:inhalt languageCode="de">&lt;p&gt;Im Rahmen der GRW können verschiedene Maßnahmen (Investitionen, Innovationen, Kooperationen, Vernetzungen) gefördert werden.&lt;/p&gt;</xzufi:inhalt><xzufi:inhalt languageCode="en">&lt;p&gt;Within the framework of the GRW, various measures (investments, innovations, cooperations, networking) can be supported.&lt;/p&gt;</xzufi:inhalt><xzufi:leikaTextmodul listURI="urn:de:xzufi:codeliste:leistungstextmodulleika" listVersionID="20190605"><code>05</code></xzufi:leikaTextmodul></xzufi:modulText><xzufi:modulText><xzufi:positionDarstellung>14</xzufi:positionDarstellung><xzufi:inhalt languageCode="en">&lt;p&gt;Further information can be found on the website of the Federal Ministry of Economics and Energy (BMWI) and the State Government of Schleswig-Holstein.&lt;/p&gt;</xzufi:inhalt><xzufi:inhalt languageCode="de">&lt;p&gt;Weitere Informationen finden Sie auf den Internetseiten des Bundesministeriums für Wirtschaft und Energie (BMWI) und der Landesregierung Schleswig-Holstein.&lt;/p&gt;</xzufi:inhalt><xzufi:leikaTextmodul listURI="urn:de:xzufi:codeliste:leistungstextmodulleika" listVersionID="20190605"><code>16</code></xzufi:leikaTextmodul><xzufi:weiterfuehrenderLink languageCode="de"><xzufi:uri>https://www.schleswig-holstein.de/DE/Fachinhalte/F/foerderprogramme/MWAVT/grw_2014_2020.html</xzufi:uri><xzufi:titel>Schleswig-Holstein - GRW</xzufi:titel><xzufi:beschreibung>Keine weiteren Hinweise vorhanden</xzufi:beschreibung><xzufi:positionDarstellung>0</xzufi:positionDarstellung></xzufi:weiterfuehrenderLink><xzufi:weiterfuehrenderLink languageCode="en"><xzufi:uri>https://www.schleswig-holstein.de/DE/Fachinhalte/F/foerderprogramme/MWAVT/grw_2014_2020.html</xzufi:uri><xzufi:titel>Schleswig-Holstein - GRW</xzufi:titel><xzufi:beschreibung>Keine weiteren Hinweise vorhanden</xzufi:beschreibung><xzufi:positionDarstellung>1</xzufi:positionDarstellung></xzufi:weiterfuehrenderLink><xzufi:weiterfuehrenderLink languageCode="de"><xzufi:uri>http://www.bmwi.de/DE/Themen/Wirtschaft/Regionalpolitik/gemeinschaftsaufgabe.html</xzufi:uri><xzufi:titel>BMWI - GRW</xzufi:titel><xzufi:beschreibung>Keine weiteren Hinweise vorhanden</xzufi:beschreibung><xzufi:positionDarstellung>2</xzufi:positionDarstellung></xzufi:weiterfuehrenderLink><xzufi:weiterfuehrenderLink languageCode="en"><xzufi:uri>http://www.bmwi.de/DE/Themen/Wirtschaft/Regionalpolitik/gemeinschaftsaufgabe.html</xzufi:uri><xzufi:titel>BMWI - GRW</xzufi:titel><xzufi:beschreibung>Keine weiteren Hinweise vorhanden</xzufi:beschreibung><xzufi:positionDarstellung>3</xzufi:positionDarstellung></xzufi:weiterfuehrenderLink></xzufi:modulText><xzufi:modulText><xzufi:positionDarstellung>1</xzufi:positionDarstellung><xzufi:inhalt languageCode="en">&lt;p&gt;Within the framework of the federal-state joint task "Improvement of the regional economic structure" commercial investments, investments in municipal infrastructure close to the economy, non-investment in business innovation measures by small and medium-sized enterprises as well as cooperation and networking projects can be supported in structurally weak areas of the state of Schleswig-Holstein (C and D-assisted areas).&lt;/p&gt;</xzufi:inhalt><xzufi:inhalt languageCode="de">&lt;p&gt;Im Rahmen der Bund-Länder-Gemeinschaftsaufgabe "Verbesserung der regionalen Wirtschaftsstruktur" können in strukturschwachen Gebieten des Landes Schleswig-Holsteins (C- und D-Fördergebiete) gewerbliche Investitionen, Investitionen in die kommunale wirtschaftsnahe Infrastruktur, nicht-investive betriebliche Innovationsmaßnahmen von kleineren und mittleren Unternehmen sowie Kooperations- und Vernetzungsvorhaben gefördert werden.&lt;/p&gt;</xzufi:inhalt><xzufi:leikaTextmodul listURI="urn:de:xzufi:codeliste:leistungstextmodulleika" listVersionID="20190605"><code>06</code></xzufi:leikaTextmodul></xzufi:modulText><xzufi:modulText><xzufi:positionDarstellung>13</xzufi:positionDarstellung><xzufi:inhalt languageCode="de">&lt;p&gt; Die Antragstellung ist formgebunden. &lt;br&gt; Die GRW-Antragsformulare finden Sie&amp;#xa0;auf den Internetseiten&amp;#xa0;der Investitionsbank Schleswig-Holstein (IB SH). &lt;/p&gt;</xzufi:inhalt><xzufi:inhalt languageCode="en">&lt;p&gt; The application is formal. &lt;br&gt; The GRW application forms can be found on the website of the Schleswig-Holstein Investment Bank (IB SH). &lt;/p&gt;</xzufi:inhalt><xzufi:leikaTextmodul listURI="urn:de:xzufi:codeliste:leistungstextmodulleika" listVersionID="20190605"><code>14</code></xzufi:leikaTextmodul><xzufi:weiterfuehrenderLink languageCode="en"><xzufi:uri>https://www.schleswig-holstein.de/DE/Fachinhalte/F/foerderprogramme/MWAVT/grw_2014_2020.html</xzufi:uri><xzufi:titel>GRW application procedure</xzufi:titel><xzufi:beschreibung>Keine weiteren Hinweise vorhanden</xzufi:beschreibung><xzufi:positionDarstellung>0</xzufi:positionDarstellung></xzufi:weiterfuehrenderLink><xzufi:weiterfuehrenderLink languageCode="de"><xzufi:uri>https://www.schleswig-holstein.de/DE/Fachinhalte/F/foerderprogramme/MWAVT/grw_2014_2020.html</xzufi:uri><xzufi:titel>GRW-Antragsverfahren</xzufi:titel><xzufi:beschreibung>Keine weiteren Hinweise vorhanden</xzufi:beschreibung><xzufi:positionDarstellung>1</xzufi:positionDarstellung></xzufi:weiterfuehrenderLink></xzufi:modulText><xzufi:modulFrist><xzufi:beschreibung languageCode="en">&lt;p&gt;No&lt;/p&gt;</xzufi:beschreibung><xzufi:beschreibung languageCode="de">&lt;p&gt;Keine&lt;/p&gt;</xzufi:beschreibung></xzufi:modulFrist><xzufi:modulKosten><xzufi:beschreibung languageCode="de">&lt;p&gt;Keine&lt;/p&gt;</xzufi:beschreibung><xzufi:beschreibung languageCode="en">&lt;p&gt;No&lt;/p&gt;</xzufi:beschreibung></xzufi:modulKosten><xzufi:modulUrsprungsportal><xzufi:positionDarstellung>1</xzufi:positionDarstellung><xzufi:uri>https://zufish.schleswig-holstein.de/portaldeeplink?tsa_leistung_id=8963791&amp;tsa_sprache=de_DE</xzufi:uri><xzufi:titel>Gemeinschaftsaufgabe „Verbesserung der regionalen Wirtschaftsstruktur“ (GRW) in der Förderperiode 2014-2020</xzufi:titel></xzufi:modulUrsprungsportal><xzufi:modulUrsprungsportal><xzufi:positionDarstellung>2</xzufi:positionDarstellung><xzufi:uri>https://zufish.schleswig-holstein.de/portaldeeplink?tsa_leistung_id=8963791&amp;tsa_sprache=en_EN</xzufi:uri><xzufi:titel>Joint task "Improvement of the regional economic structure" (GRW) in the 2014-2020 funding period</xzufi:titel></xzufi:modulUrsprungsportal><xzufi:typisierung listURI="urn:de:fim:leika:typisierung" listVersionID="20201204"><code>4</code><name>Regelungskompetenz auf Landesebene</name></xzufi:typisierung><xzufi:kennzeichenSchriftformerfordernis>false</xzufi:kennzeichenSchriftformerfordernis><xzufi:kategorie><xzufi:klasse><xzufi:id schemeAgencyID="L100012" schemeID="TELEPORT_LKK">Lebenslage</xzufi:id><xzufi:bezeichnung languageCode="de">Lebens- und Unternehmenslage</xzufi:bezeichnung></xzufi:klasse><xzufi:id schemeAgencyID="L100012" schemeID="OID">8935733</xzufi:id><xzufi:uebergeordneteKategorieID schemeAgencyID="L100012" schemeID="OID">8935703</xzufi:uebergeordneteKategorieID><xzufi:bezeichnung languageCode="de">Wirtschaftsförderung</xzufi:bezeichnung><xzufi:beschreibung languageCode="de">&lt;p&gt;Wirtschaftsförderung&lt;/p&gt;</xzufi:beschreibung></xzufi:kategorie><xzufi:gueltigkeitGebietID schemeID="urn:de:bund:destatis:bevoelkerungsstatistik:schluessel:bundesland" schemeVersionID="2018-07-31">010000000000</xzufi:gueltigkeitGebietID><xzufi:kennzeichenEA>false</xzufi:kennzeichenEA><xzufi:versionsinformation><xzufi:geaendertDatumZeit>2021-03-11T12:47:41+01:00</xzufi:geaendertDatumZeit></xzufi:versionsinformation><xzufi:sprachversion><xzufi:languageCode>de</xzufi:languageCode><xzufi:sprachbezeichnungDeutsch>Deutsch</xzufi:sprachbezeichnungDeutsch><xzufi:sprachbezeichnungNativ>Deutsch</xzufi:sprachbezeichnungNativ></xzufi:sprachversion></xzufi:leistung></xzufi:schreibe>
    <xzufi:schreibe><xzufi:spezialisierung><xzufi:idLeistung schemeAgencyID="L100012" schemeID="OID">8963791</xzufi:idLeistung><xzufi:idGebiet schemeID="urn:de:bund:destatis:bevoelkerungsstatistik:schluessel:rs" schemeVersionID="2018-07-31">010030000000</xzufi:idGebiet><xzufi:bezeichnung languageCode="de">Wirtschaftsförderung/-koordination</xzufi:bezeichnung><xzufi:modulSpezialisiert><xzufi:modul xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="xzufi:Textmodul"><xzufi:positionDarstellung>14</xzufi:positionDarstellung><xzufi:inhalt languageCode="de">&lt;p&gt; &lt;br&gt; Die Wirtschaftskoordination hat eine Lotsenfunktion bei Abstimmungen mit den Behörden der Hansestadt Lübeck. Bei der Durchführung von Genehmigungsverfahren bei Ansiedlung oder Umsiedlung von Unternehmen wie auch für weitere Sachfragen steht Ihnen die Wirtschaftskoordination hilfreich zur Verfügung. Die Wirtschaftskoordination nimmt sich Ihres Anliegens an und wird in Abstimmung mit den zu beteiligenden Bereichen der Hansestadt Lübeck Lösungen anstreben. &lt;/p&gt;</xzufi:inhalt><xzufi:leikaTextmodul listURI="urn:de:xzufi:codeliste:leistungstextmodulleika" listVersionID="20190605"><code>16</code></xzufi:leikaTextmodul></xzufi:modul><xzufi:ersetzung>false</xzufi:ersetzung></xzufi:modulSpezialisiert><xzufi:modulSpezialisiert><xzufi:modul xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="xzufi:Textmodul"><xzufi:positionDarstellung>5</xzufi:positionDarstellung><xzufi:inhalt languageCode="de">&lt;p&gt; &lt;br&gt; Wirtschafts- und Flughafenkoordination &lt;br&gt; Fischstraße 1-3 &lt;br&gt; 23539 Lübeck &lt;/p&gt;</xzufi:inhalt><xzufi:leikaTextmodul listURI="urn:de:xzufi:codeliste:leistungstextmodulleika" listVersionID="20190605"><code>22</code></xzufi:leikaTextmodul></xzufi:modul><xzufi:ersetzung>false</xzufi:ersetzung></xzufi:modulSpezialisiert><xzufi:modulSpezialisiert><xzufi:modul xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="xzufi:Textmodul"><xzufi:positionDarstellung>4</xzufi:positionDarstellung><xzufi:inhalt languageCode="de">&lt;p&gt; &lt;br&gt; Ansprechpartner für die Vermarktung von Gewerbegrundstücken der Hansestadt Lübeck oder des Koordinierungsbüros Wirtschaft (KWL) ist generell die Wirtschaftsförderung Lübeck GmbH &lt;/p&gt;</xzufi:inhalt><xzufi:leikaTextmodul listURI="urn:de:xzufi:codeliste:leistungstextmodulleika" listVersionID="20190605"><code>23</code></xzufi:leikaTextmodul></xzufi:modul><xzufi:ersetzung>false</xzufi:ersetzung></xzufi:modulSpezialisiert><xzufi:modulSpezialisiert><xzufi:modul xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="xzufi:UrsprungsportalModul"><xzufi:positionDarstellung>1</xzufi:positionDarstellung><xzufi:uri>https://zufish.schleswig-holstein.de/portaldeeplink?tsa_leistung_id=8963791&amp;tsa_gebiet_id=9006403&amp;tsa_sprache=de_DE</xzufi:uri><xzufi:titel>Wirtschaftsförderung/-koordination in Lübeck, Hansestadt</xzufi:titel></xzufi:modul><xzufi:ersetzung>false</xzufi:ersetzung></xzufi:modulSpezialisiert><xzufi:id schemeAgencyID="L100012" schemeID="OID">242354922_9006403</xzufi:id></xzufi:spezialisierung></xzufi:schreibe>
