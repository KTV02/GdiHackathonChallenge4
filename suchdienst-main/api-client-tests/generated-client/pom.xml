<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>de.dataport.suchdienst</groupId>
        <artifactId>api-client-tests</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>generated-client</artifactId>
    <dependencies>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>remove-previous-client-generation</id>
                        <phase>initialize</phase>
                        <goals><goal>clean</goal></goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset><directory>${project.build.directory}/openapi</directory></fileset>
                                <fileset><directory>${project.build.outputDirectory}</directory></fileset>
                                <fileset><directory>${project.build.directory}/maven-status/maven-compiler-plugin</directory></fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <dependencies>
                    <dependency>
                        <groupId>org.openapitools</groupId>
                        <artifactId>openapi-generator-cli</artifactId>
                        <version>${openapi-generator.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>generate-client-with-cli</id>
                        <phase>generate-sources</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>org.openapitools.codegen.OpenAPIGenerator</mainClass>
                            <includePluginDependencies>true</includePluginDependencies>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <blockSystemExit>true</blockSystemExit>
                            <arguments>
                                <argument>generate</argument>
                                <argument>-i</argument><argument>${openapi.spec}</argument>
                                <argument>-g</argument><argument>java</argument>
                                <argument>-c</argument><argument>${project.basedir}/../generator-config.json</argument>
                                <argument>-o</argument><argument>${project.build.directory}/openapi</argument>
                                <argument>--global-property</argument>
                                <argument>apiTests=false,modelTests=false,apiDocs=false,modelDocs=false</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>add-generated-client</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration>
                            <sources><source>${project.build.directory}/openapi/src/main/java</source></sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
