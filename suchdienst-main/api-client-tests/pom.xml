<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>de.dataport.suchdienst</groupId>
    <artifactId>api-client-tests</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Suchdienst OpenAPI Clienttests</name>
    <licenses>
        <license>
            <name>EUPL-1.2</name>
            <url>https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <modules>
        <module>generated-client</module>
        <module>client-tests</module>
    </modules>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <openapi-generator.version>7.27.0</openapi-generator.version>
        <spring-boot.version>4.1.2</spring-boot.version>
        <openapi.spec>${project.basedir}/../../target/docs/openapi.yml</openapi.spec>
        <suchdienst.base-url>http://localhost:8080</suchdienst.base-url>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <java>
                        <includes>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <prettier>
                            <config>
                                <plugins>prettier-plugin-java</plugins>
                                <printWidth>120</printWidth>
                                <tabWidth>4</tabWidth>
                                <useTabs>false</useTabs>
                            </config>
                            <devDependencies>
                                <prettier>3.9.6</prettier>
                                <prettier-plugin-java>2.10.3</prettier-plugin-java>
                            </devDependencies>
                        </prettier>
                    </java>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
